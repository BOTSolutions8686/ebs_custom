  "html": "{% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n\r\n{% if letter_head and not no_letterhead -%}\r\n    {% if print_settings.repeat_header_footer %}\r\n        <div id=\"header-html\" class=\"hidden-pdf\">\r\n            <div class=\"letter-head\">\r\n                {{ letter_head }}\r\n            </div>\r\n        </div>\r\n    {%- endif %}\r\n{%- endif %}\r\n\r\n<!-- Main Container -->\r\n<div style=\"max-width:100%; margin:0 auto; padding:20px; font-family:Arial, sans-serif;\">\r\n\r\n    \r\n    <div style=\"text-align:center; margin-bottom:20px;\">\r\n        <h3 style=\"color:#1f4e79; text-transform:uppercase; margin-top:10px; padding-bottom:8px; letter-spacing:1px;\">\r\n            Salary Statement Request\r\n        </h3>\r\n    </div>\r\n\r\n    <!-- Introductory Paragraph - According to Salary Statement Request Data -->\r\n<p style=\"font-size:14px; color:#333; margin-bottom:20px; line-height:1.6; text-align:justify;\">\r\n    This is to certify that the following information has been prepared and issued upon the employee's request based on the records available with the Company. The particulars stated below accurately reflect the employee's information as maintained in the Company's official records.\r\n</p>\r\n\r\n    <!-- Employee Details Table -->\r\n    <table style=\"width:100%; border-collapse:collapse; margin-bottom:20px; border:1px solid #dee2e6; font-size:14px;\">\r\n        <thead>\r\n            <tr>\r\n                <th colspan=\"2\" style=\"background:#f4f7fa; color:#1f4e79; font-weight:600; padding:12px 15px; border:1px solid #dee2e6; text-align:left;\">\r\n                    Employee Details\r\n                </th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td style=\"font-weight:600; padding:8px 15px; border:1px solid #dee2e6; width:35%;\">\r\n                    Name\r\n                </td>\r\n                <td style=\"padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    {{ doc.employee_name }}\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"font-weight:600; padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    Employee ID\r\n                </td>\r\n                <td style=\"padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    {{ doc.employee }}\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"font-weight:600; padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    Designation\r\n                </td>\r\n                <td style=\"padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    {{ doc.designation }}\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"font-weight:600; padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    Date of Joining\r\n                </td>\r\n                <td style=\"padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    {{ frappe.utils.formatdate(doc.date_of_joining) }}\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- Request Details Table -->\r\n    <table style=\"width:100%; border-collapse:collapse; margin-bottom:20px; border:1px solid #dee2e6; font-size:14px;\">\r\n        <thead>\r\n            <tr>\r\n                <th colspan=\"2\" style=\"background:#f4f7fa; color:#1f4e79; font-weight:600; padding:12px 15px; border:1px solid #dee2e6; text-align:left;\">\r\n                    Request Details\r\n                </th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            <tr>\r\n                <td style=\"font-weight:600; padding:8px 15px; border:1px solid #dee2e6; width:35%;\">\r\n                    Request Date\r\n                </td>\r\n                <td style=\"padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    {{ frappe.utils.formatdate(doc.request_date) }}\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"font-weight:600; padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    Purpose\r\n                </td>\r\n                <td style=\"padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    {{ doc.purpose }}\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"font-weight:600; padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    Remarks\r\n                </td>\r\n                <td style=\"padding:8px 15px; border:1px solid #dee2e6;\">\r\n                    {{ doc.remarks or \"-\" }}\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n</div>\r\n\r\n{% if print_settings.repeat_header_footer %}\r\n    <div id=\"footer-html\">\r\n        {% if not no_letterhead and footer %}\r\n            <div class=\"letter-head-footer\">\r\n                {{ footer }}\r\n            </div>\r\n        {% endif %}\r\n    </div>\r\n{% endif %}",
